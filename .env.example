# LOCAL side (for test_chat.sh / chat_client.py). Copy to .env, never commit .env.
# Values are printed by scripts/serve.sh when you run it inside the pod.
API_URL=https://<POD_ID>-8000.proxy.runpod.net/v1
VLLM_API_KEY=<printed-by-serve.sh>          # persisted in-pod at /workspace/.vllm_api_key
MODEL=Qwen/Qwen2.5-3B-Instruct

# POD side: no keys needed — serve.sh generates and persists the API key itself.
# Optional in-pod overrides:  MODEL / PORT / MAX_LEN / GPU_UTIL / HF_TOKEN (gated models)
